<Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <AuthorizeRouteView @key="routeData" RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
            <NotAuthorized><p>Sign in with an authorized account. <a href="/login" data-enhance-nav="false">Login</a></p></NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>
