@using Shared.Contracts
@page "/operations"
@attribute [Authorize(Roles="Admin")]
@rendermode InteractiveServer
@implements IDisposable
@inject Gateway.Web.Business.BusinessClient Client
<PageTitle>Lab operations</PageTitle>
<h1>Lab operations</h1>
<p>Simulations only. Refresh reads one selected service. DLQ inspection receives messages and hides them for 120 seconds; inspection expires after 110 seconds. No automatic polling.</p>
<label>Service <select disabled="@busy" @bind="service" @bind:after="Changed"><option value="Catalog">Catalog</option><option value="Reservations">Reservations</option><option value="Payments">Payments</option><option value="Notifications">Notifications</option></select></label>
<button @onclick="Refresh" disabled="@busy">Refresh diagnostics and fault configuration</button>
@if(busy){<p role="status">Loading…</p>}
@if(error is not null){<p role="alert">@error</p>}
@if(outcome is not null){<p role="status">@outcome</p>}
@if(diagnostics is not null)
{
    <p>@diagnostics.Service: pending Outbox @diagnostics.PendingOutboxCount, oldest @diagnostics.OldestOutboxSeconds.ToString("F1") seconds; DLQ approximately @diagnostics.ApproximateDlqCount (-1 means unavailable). Ignored duplicates @diagnostics.IgnoredDuplicates in this instance.</p>
    <h2>Workers</h2>
    <table><thead><tr><th>Worker</th><th>Enabled</th><th>Status</th><th>Last successful check</th><th>Last failure type</th></tr></thead><tbody>
    @foreach(var row in diagnostics.Workers){<tr><td>@row.Name</td><td>@row.Enabled</td><td>@row.Status</td><td>@row.LastSuccessUtc</td><td>@row.LastFailureType</td></tr>}
    </tbody></table>
    <h2>Owned work counts</h2>
    @foreach(var row in diagnostics.WorkByState){<p>@row.Key: @row.Value</p>}
    <h2>Outbox — page @(page)</h2>
    <table><thead><tr><th>Delivery</th><th>Message</th><th>Type / destination</th><th>Attempts</th><th>Created</th><th>Published</th><th>Lease expires</th></tr></thead><tbody>
    @foreach(var row in diagnostics.Outbox){<tr><td>@row.DeliveryId</td><td>@row.MessageId</td><td>@row.Type / @row.Destination</td><td>@row.Attempts</td><td>@row.CreatedAtUtc</td><td>@row.PublishedAtUtc</td><td>@row.LeaseUntilUtc</td></tr>}
    </tbody></table>
    <h2>Inbox — page @(page)</h2>
    <table><thead><tr><th>Consumer</th><th>Message</th><th>Committed</th></tr></thead><tbody>
    @foreach(var row in diagnostics.Inbox){<tr><td>@row.Consumer</td><td>@row.MessageId</td><td>@row.ProcessedAtUtc</td></tr>}
    </tbody></table>
    <button @onclick="Previous" disabled="@(busy || page==1)">Previous</button><button @onclick="Next" disabled="@busy">Next</button>
}
<h2>Controlled fault</h2>
@if(fault is not null){<p>Persisted mode @fault.Mode, remaining @fault.Remaining occurrences.</p>}
<label>Mode <select @bind="mode">@foreach(var value in Modes){<option value="@value">@value</option>}</select></label>
<label>Occurrences (0–100) <input type="number" min="0" max="100" @bind="occurrences" /></label>
<button @onclick="SetFault" disabled="@busy">Apply simulation</button><button @onclick="Reset" disabled="@busy">Reset to normal</button>
<h2>Dead letters</h2>
<p>Correct the consumer or configuration before replay. Replay preserves the original identity and can produce duplicate delivery. A malformed envelope cannot be edited here.</p>
<button @onclick="Inspect" disabled="@busy">Receive up to 10 from this service’s DLQ</button>
@if(letters is not null)
{
    @if(letters.Length==0){<p>No visible messages received. Others may be invisible or awaiting redrive.</p>}
    <table><thead><tr><th>Delivery</th><th>Message</th><th>Type</th><th>Saga</th><th>Inspection expires</th><th>Action</th></tr></thead><tbody>
    @foreach(var row in letters){<tr><td>@row.DeliveryId</td><td>@row.MessageId</td><td>@row.Type</td><td>@row.SagaId</td><td>@row.InspectionExpiresAtUtc</td><td><button disabled="@(busy || !row.Replayable || DateTimeOffset.UtcNow>=row.InspectionExpiresAtUtc)" @onclick="()=>Replay(row.DeliveryId)">Replay original message</button></td></tr>}
    </tbody></table>
}
@code {
    private LabService service=LabService.Catalog;
    private ServiceDiagnostics? diagnostics; private FaultView? fault; private DeadLetterView[]? letters;
    private string mode="None"; private int occurrences=1;private int page=1;private bool busy;private string? error;private string? outcome;
    private readonly CancellationTokenSource stop=new();
    private string[] Modes=>service switch { LabService.Catalog=>["None","QuoteTimeout","RejectNextConfirmation","PauseConsumption"],LabService.Reservations=>["None","PauseOutbox"],LabService.Payments=>["Success","Decline","TimeoutAfterCharge","UnknownUntilAdminResolution","RefundTransientFailure","PauseConsumption"],_=>["None","FailureThenSuccess"] };
    private Task Changed(){diagnostics=null;fault=null;letters=null;page=1;mode=Modes[0];outcome=null;return Task.CompletedTask;}
    private async Task Run(Func<CancellationToken,Task> action)
    {
        if(busy)return;busy=true;error=null;outcome=null;
        using var bounded=CancellationTokenSource.CreateLinkedTokenSource(stop.Token);bounded.CancelAfter(TimeSpan.FromSeconds(30));
        try{await action(bounded.Token);}catch(OperationCanceledException) when(stop.IsCancellationRequested){}catch(Exception e) when(e is Gateway.Web.Catalog.CatalogClientException or HttpRequestException or OperationCanceledException){error=e is OperationCanceledException?"Operation timed out; refresh before retrying an uncertain replay.":e.Message;}finally{busy=false;}
    }
    private Task Refresh()=>Run(async ct=>{var selected=service;var view=await Client.DiagnosticsAsync(selected,page,ct);var configuration=await Client.ServiceFaultAsync(selected,ct);if(selected==service){diagnostics=view;fault=configuration;}});
    private async Task Previous(){page=Math.Max(1,page-1);await Refresh();}
    private async Task Next(){page++;await Refresh();}
    private Task SetFault()=>Run(async ct=>{fault=await Client.SetServiceFaultAsync(service,new(mode,occurrences),ct);outcome="Simulation configured durably.";});
    private Task Reset()=>Run(async ct=>{fault=await Client.ResetServiceFaultAsync(service,ct);outcome="Normal behavior restored; durable work remains.";});
    private Task Inspect()=>Run(async ct=>{var selected=service;var rows=await Client.DeadLettersAsync(selected,ct);if(selected==service)letters=rows;});
    private Task Replay(Guid id)=>Run(async ct=>{var result=await Client.ReplayAsync(service,id,ct);outcome=result.Outcome+". Duplicate delivery remains possible.";letters=letters?.Where(x=>x.DeliveryId!=id).ToArray();});
    public void Dispose(){stop.Cancel();stop.Dispose();}
}
