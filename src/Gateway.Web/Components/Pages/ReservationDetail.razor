@page "/reservations/{Id:guid}"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IAsyncDisposable
@inherits Gateway.Web.Catalog.CatalogComponent
@inject Gateway.Web.Reservations.ReservationClient ReservationsClient
<h1>Reservation</h1><a href="/reservations">Back to list</a>
<button disabled="@Busy" @onclick="Load">Reload</button>
@if (Busy) { <p role="status">Loading…</p> }
@if (Error is not null) { <p role="alert">@Error</p> }
@if (reservation is not null)
{
    <p>@reservation.Id — @reservation.Status</p><p>@reservation.Reason</p>
    @if(reservation.Compensation is { } progress && (progress.RefundRequired || progress.SeatsReleaseRequired))
    {<p>Simulated refund: @(progress.RefundRequired?(progress.RefundCompleted?"completed":"pending"):"not required"); seat release: @(progress.SeatsReleased?"completed":"pending").</p>}
    <p>Participants: @reservation.Participants; agreed total: @((reservation.TotalAmountMinor / 100m).ToString("0.00")) @reservation.Currency</p>
    <p>Departure (UTC): @reservation.StartsAtUtc.ToString("u")</p>
    <p>Payments and notifications are simulated. Confirmation requires both a successful simulated charge and Catalog seat confirmation. Cancellation waits for a full simulated refund and seat release. ManualReview requires authorized recovery.</p>
    <p><a href="@($"/payments?reservationId={Id}")">Inspect simulated payment</a> · <a href="@($"/notifications?reservationId={Id}")">Inspect simulated notifications</a></p>
    @if(reservation.Status=="Confirmed" && reservation.StartsAtUtc>DateTimeOffset.UtcNow){<button disabled="@Busy" @onclick="Cancel">Cancel with a full simulated refund</button>}
    <h2>Timeline</h2><ul>@foreach (var item in timeline) { <li>@item.OccurredAtUtc.ToString("u"): @item.From → @item.To @item.Reason</li> }</ul>
}
@code {
    [Parameter] public Guid Id { get; set; }
    private Shared.Contracts.ReservationView? reservation; private Shared.Contracts.TransitionView[] timeline = [];
    private Task? polling; private string cancellationKey=Guid.NewGuid().ToString("N");private Guid intentionReservation;private bool rendered;
    private Task Cancel()=>RunAsync(async ct=>{await ReservationsClient.CancelAsync(Id,cancellationKey,ct);reservation=await ReservationsClient.DetailAsync(Id,ct);timeline=await ReservationsClient.TimelineAsync(Id,ct);if(polling is null || polling.IsCompleted)polling=PollAsync();});
    protected override async Task OnParametersSetAsync()
    {
        if(intentionReservation!=Id){intentionReservation=Id;cancellationKey=Guid.NewGuid().ToString("N");}
        reservation=null;timeline=[];
        await Load();if(rendered && (polling is null || polling.IsCompleted))polling=PollAsync();
    }
    protected override Task OnAfterRenderAsync(bool firstRender)
    { if (firstRender){rendered=true;polling = PollAsync();} return Task.CompletedTask; }
    private async Task Load(){await RunAsync(async ct => { reservation = await ReservationsClient.DetailAsync(Id, ct); timeline = await ReservationsClient.TimelineAsync(Id, ct); });if(rendered && Error is null && (polling is null || polling.IsCompleted))polling=PollAsync();}
    private async Task PollAsync()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
            while (Error is null && reservation is not null && reservation.Status is not ("Failed" or "Confirmed" or "Cancelled" or "ManualReview")
                && await timer.WaitForNextTickAsync(Lifetime.Token)) await InvokeAsync(async () => { await Load(); StateHasChanged(); });
        }
        catch (OperationCanceledException) when (Lifetime.IsCancellationRequested) { }
    }
    public async ValueTask DisposeAsync() { Lifetime.Cancel(); if (polling is not null) await polling; Dispose(); }
}
